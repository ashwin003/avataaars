{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "declaration": true,
    "newLine": "lf",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": [
      "es6",
      "dom"
    ]
  },
  "include": [
    "src"
  ]
}
